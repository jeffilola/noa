{
  "name": "noa",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/qa-servers.mjs",
    "dev:all": "turbo run dev --parallel",
    "test": "turbo run test",
    "lint": "pnpm db:generate && turbo run lint",
    "db:generate": "pnpm --filter @noa/database generate",
    "db:migrate": "pnpm --filter @noa/database migrate",
    "db:seed": "pnpm --filter @noa/database seed",
    "db:up": "docker compose up -d postgres",
    "dev:stack": "docker compose up -d postgres && turbo run dev --parallel",
    "qa:prepare": "node scripts/qa-prepare.mjs",
    "qa:stop": "node scripts/qa-stop.mjs",
    "qa:servers": "node scripts/qa-servers.mjs",
    "qa:smoke": "node scripts/qa-smoke.mjs",
    "qa:dev": "node scripts/qa-prepare.mjs && node scripts/qa-servers.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "turbo": "^2.10.4",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.2.16",
      "@types/react-dom": "^19.2.3",
      "prisma": "6.19.3"
    }
  }
}
